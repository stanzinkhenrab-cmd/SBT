<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Seabuckthorn" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/berry_orange</item>
        <item name="android:windowBackground">@color/mountain_grey_light</item>
    </style>

    <style name="Theme.Seabuckthorn.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mountain_grey_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_seabuckthorn_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Seabuckthorn</item>
    </style>
</resources>
