<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the survey database, the photo folder and the surveyor preferences are
  backed up. Everything else in app storage - the osmdroid tile cache, generated
  export files - is regenerable and is left out by not being included here.
-->
<full-backup-content>
    <include
        domain="database"
        path="." />
    <include
        domain="file"
        path="photos/" />
    <include
        domain="sharedpref"
        path="." />
</full-backup-content>
