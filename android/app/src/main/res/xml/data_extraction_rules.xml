<?xml version="1.0" encoding="utf-8"?>
<!--
  Survey records, photographs and the surveyor profile move with the app to a new
  phone. The osmdroid tile cache and generated export files are not listed, so
  they are not carried over.
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="database"
            path="." />
        <include
            domain="file"
            path="photos/" />
        <include
            domain="sharedpref"
            path="." />
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="." />
        <include
            domain="file"
            path="photos/" />
        <include
            domain="sharedpref"
            path="." />
    </device-transfer>
</data-extraction-rules>
